{
  "name": "@ebookd/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ebookd backend: multi-user ebook repository, metadata extraction, byte-range delivery.",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.0.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "range-parser": "^1.3.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "~24.13.6",
    "@types/range-parser": "^1.2.7",
    "@types/yauzl": "^2.10.3",
    "fflate": "^0.8.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
