# Copy to .env (git-ignored). docker compose reads deploy/.env instead.
# Every value below is optional unless marked REQUIRED; defaults suit a single-user LAN box.

# development | production | test
NODE_ENV=development

# Bind on all interfaces so a phone on the LAN can reach it. Windows will prompt for a
# firewall allowance on first listen — accept it for Private networks only.
EBOOK_HOST=0.0.0.0
# 8000 is already taken on this dev machine; 8787 is the documented default everywhere.
EBOOK_PORT=8787

# Storage. In the container these are /data/db and /data/library on named volumes.
# EBOOK_DATA_DIR MUST NOT live on a /mnt/c (9p) bind mount: WAL has no working advisory
# locking there and the database will corrupt.
EBOOK_DATA_DIR=./data/db
EBOOK_LIBRARY_DIR=./data/library
# Optional read-only drop folder for bulk server-side import.
EBOOK_IMPORT_DIR=
# Absolute base URL used when the server emits download links. Leave empty to derive it
# from the incoming request (correct behind a reverse proxy that preserves Host).
EBOOK_PUBLIC_URL=

# Empty by default: no cross-origin browser client is allowed. The Android app is not a
# browser and the admin UI is same-origin. Comma-separated list of exact origins.
EBOOK_CORS_ORIGINS=

EBOOK_LOG_LEVEL=info
# Enable only when a trusted reverse proxy sets X-Forwarded-* (needed for correct client IP
# in rate limiting and audit logs).
EBOOK_TRUST_PROXY=false
# Self-service signup stays off; an admin creates accounts.
EBOOK_ALLOW_REGISTRATION=false

EBOOK_MAX_UPLOAD_MB=512
# A deleted book's files (and a replaced one) stay downloadable for this long, so in-flight
# downloads and other devices' partials are not corrupted mid-transfer. After that the bytes move
# to trash/ for a further 24 h and are then unlinked — this window is the only thing that decides
# how long the volume keeps growing after you delete something.
EBOOK_FILE_RETENTION_DAYS=7
# How often the retention sweep runs. Idempotent, and it never deletes anything inside the window
# above, so raising it only defers reclaiming disk.
EBOOK_SWEEP_INTERVAL_HOURS=6

EBOOK_ACCESS_TTL_SECONDS=900
EBOOK_REFRESH_IDLE_DAYS=30
EBOOK_REFRESH_ABSOLUTE_DAYS=90

# REQUIRED in production (the server refuses to boot otherwise). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EBOOK_JWT_SECRET=
EBOOK_MASTER_KEY=

# Bootstrap admin is created by the migration in M2; consumed once, then delete these lines.
EBOOK_ADMIN_USER=admin
EBOOK_ADMIN_PASSWORD=
