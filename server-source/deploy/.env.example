# Copy to deploy/.env and fill the two secrets. docker compose reads this file automatically when
# invoked with -f deploy/docker-compose.yml from the repository root.

# REQUIRED. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   openssl rand -base64 32
# The server refuses to start in production if either is missing, on purpose: a development
# fallback key on a LAN-reachable port is an open library.
EBOOK_JWT_SECRET=
EBOOK_MASTER_KEY=

# Host port. The container always listens on 8787 internally.
EBOOK_PORT=8787
# Set to 127.0.0.1 when a reverse proxy (Caddy, Synology Application Portal, nginx) sits in front.
EBOOK_BIND=0.0.0.0

# Created once, only when the database is empty. If you leave the password blank the server
# generates one and logs it a single time — check `docker compose logs ebookd` for it.
EBOOK_ADMIN_USER=admin
EBOOK_ADMIN_PASSWORD=

# Self-service signup stays off; create accounts in the admin console.
EBOOK_ALLOW_REGISTRATION=false

# Largest single upload. Raise it for comic archives; note the client must handle the timeout.
EBOOK_MAX_UPLOAD_MB=512

# Only true behind a trusted reverse proxy. With it off, X-Forwarded-For is ignored, which is the
# safe default because anyone can send that header.
EBOOK_TRUST_PROXY=false

EBOOK_LOG_LEVEL=info
TZ=Asia/Shanghai
